# Windows PC role: worker, Telegram admin bot, and local aria2.
DEPLOYMENT_ROLE=pc
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=aniz
MONGODB_SYNC_ENABLED=true

# Telegram user session and storage channel.
API_ID=replace-me
API_HASH=replace-me
STRING_SESSION=replace-me
TG_CHANNEL_ID=-1000000000000

# Telegram admin bot and allowed numeric user IDs.
BOT_TOKEN=replace-me
ADMIN_USER_IDS=123456789

# Local aria2 JSON-RPC.
ARIA2_HOST=127.0.0.1
ARIA2_PORT=6800
ARIA2_SECRET=replace-me

# Processing behavior.
CONVERT_MKV_TO_MP4=false
TEMP_DOWNLOAD_DIR=./temp_downloads
STATE_DB_PATH=./aniz_state.sqlite3
LOG_DIR=./logs
LOG_LEVEL=INFO
NYAA_FEED_URLS=https://nyaa.si/?page=rss&c=1_2&f=0
NYAA_CHECK_INTERVAL_MINUTES=15
QUALITY_FILTERS=["1080p", "720p"]
RELEASE_GROUPS=["SubsPlease", "Erai-raws"]
ARIA2_DOWNLOAD_TIMEOUT=7200
MAX_CONCURRENT_UPLOADS=1
CLEANUP_ON_UPLOAD_FAILURE=false
