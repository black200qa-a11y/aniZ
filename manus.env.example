# Manus/cloud role: FastAPI dashboard and API only.
# Use a MongoDB Atlas URI reachable from the deployed Manus service.
DEPLOYMENT_ROLE=cloud
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=aniz

# Admin dashboard authentication. Use a long random session secret.
ADMIN_PASSWORD=replace-me
ADMIN_SESSION_SECRET=replace-me-with-a-long-random-secret

# Cloud HTTP binding.
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=https://your-manus-dashboard.example
LOG_LEVEL=INFO
LOG_DIR=./logs
MAX_CONCURRENT_STREAMS=8
STREAM_CHUNK_SIZE=1048576
