# Nyaa RSS feed URLs, comma-separated. Use feeds permitted for your content/licensing workflow.
NYAA_FEED_URLS=https://nyaa.si/?page=rss&c=1_2&f=0
NYAA_GROUPS=SubsPlease,Erai-raws
NYAA_QUALITIES=1080p,720p
NYAA_CHECK_INTERVAL=300

# Local runtime
TEMP_DOWNLOAD_DIR=./temp_downloads
STATE_DB_PATH=./aniz_state.sqlite3
ARIA2_RPC_URL=http://127.0.0.1:6800
ARIA2_SECRET=
ARIA2_DOWNLOAD_TIMEOUT=7200

# Telegram MTProto user session
API_ID=123456
API_HASH=replace-me
STRING_SESSION=replace-me
TG_CHANNEL_ID=-1001234567890

# MongoDB catalog
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=aniz
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_SYNC_ENABLED=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://127.0.0.1:8000
STREAM_MAX_CONCURRENT=8
STREAM_CHUNK_SIZE=1048576

# Operational tuning
MAX_CONCURRENT_UPLOADS=1
CLEANUP_ON_UPLOAD_FAILURE=false
LOG_LEVEL=INFO
