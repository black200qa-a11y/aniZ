# Aniz production configuration template.
# Copy to .env and replace all replace-me values.
# Do not commit .env: Telegram sessions and API hashes are secrets.

# Telegram MTProto user session. Obtain API_ID/API_HASH from my.telegram.org.
API_ID=replace-me
API_HASH=replace-me
STRING_SESSION=replace-me
# Private storage channel ID, typically -100xxxxxxxxxx.
TG_CHANNEL_ID=-1000000000000

# MongoDB. For Docker Compose use mongodb; for a host install use 127.0.0.1.
MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=aniz
MONGODB_SYNC_ENABLED=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# aria2 JSON-RPC daemon. For Docker Compose use aria2; for host install use 127.0.0.1.
ARIA2_HOST=aria2
ARIA2_PORT=6800
ARIA2_SECRET=replace-me

# FastAPI API and Telegram range-streaming proxy.
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000
STREAM_CHUNK_SIZE=1048576
MAX_CONCURRENT_STREAMS=8

# Nyaa RSS and release filters. QUALITY_FILTERS and RELEASE_GROUPS are JSON arrays.
NYAA_FEED_URLS=https://nyaa.si/?page=rss&c=1_2&f=0
NYAA_CHECK_INTERVAL_MINUTES=15
QUALITY_FILTERS=["1080p", "720p"]
RELEASE_GROUPS=["SubsPlease", "Erai-raws"]

# Worker storage and resilience.
TEMP_DOWNLOAD_DIR=./temp_downloads
STATE_DB_PATH=./aniz_state.sqlite3
ARIA2_DOWNLOAD_TIMEOUT=7200
MAX_CONCURRENT_UPLOADS=1
CLEANUP_ON_UPLOAD_FAILURE=false
LOG_LEVEL=INFO
